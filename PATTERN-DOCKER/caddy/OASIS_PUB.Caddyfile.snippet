# Candidato VPS-03 para integrar en BlockchainComPort/OASIS_PUB/caddy/Caddyfile
# NO aplicar sin validación expresa de Aleph/PO.
# Edge productivo compartido: `pub-web` de OASIS_PUB.
# Upstreams esperados en la red `oasis_pub_net` / nombre externo `oasis-pub-scriptorium_oasis_pub_net`.

# Host público pedagógico: editor/flujos visibles read-only + dashboards.
# La escritura NO se bloquea aquí: la bloquea Node-RED con adminAuth.default = read.
scriptorium.escrivivir.co {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    @health path /healthz
    handle @health {
        respond "scriptorium public edge ok" 200
    }

    reverse_proxy scriptorium-nodered:1880
}

# Host admin: acceso al mismo Node-RED; la autenticación/escritura la gobierna adminAuth interno.
admin.scriptorium.escrivivir.co {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Robots-Tag noindex, nofollow, noarchive
    }

    @health path /healthz
    handle @health {
        respond "scriptorium admin edge ok" 200
    }

    reverse_proxy scriptorium-nodered:1880
}

# Host MCP: endpoint esperado /mcp con bearer en el upstream.
mcp.scriptorium.escrivivir.co {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    @health path /healthz
    handle @health {
        respond "scriptorium mcp edge ok" 200
    }

    reverse_proxy scriptorium-mcp-devops:3003
}

# Host npm: registry público; no tocar auth interna de Verdaccio desde Caddy.
npm.scriptorium.escrivivir.co {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Robots-Tag noindex
    }

    @health path /healthz
    handle @health {
        respond "scriptorium npm edge ok" 200
    }

    reverse_proxy scriptorium-verdaccio:4873
}

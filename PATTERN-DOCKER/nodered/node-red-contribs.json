      "buildCommand": "npm run build:full",
      "smokeFiles": [
        "dist/index.js",
        "dist/nodes/alephscript-core-client.js"
      ]
    },
    {
      "name": "node-red-contrib-alephscript",
      "source": "/opt/aleph/WiringEditor/packages/node-red-contrib-alephscript",
      "buildCommand": "npm run build:full",
      "smokeFiles": [
        "dist/index.js",
        "dist/nodes/bot-node.js"
      ]
    },
    {
      "name": "node-red-contrib-alephscript-firehose",
      "source": "/opt/aleph/WiringEditor/packages/node-red-contrib-alephscript-firehose",
      "buildCommand": "npm run build:full",
      "smokeFiles": [
        "dist/index.js",
        "dist/nodes/firehose-consumer.js"
      ]
    },
    {
      "name": "node-red-dashboard-2-alephscript-escribiente",
      "source": "/opt/aleph/WiringEditor/packages/node-red-contrib-alephscript-escribiente",
      "buildCommand": "npm run build:full",

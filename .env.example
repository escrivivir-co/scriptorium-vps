# Dominios públicos
SCRIPTORIUM_DOMAIN=scriptorium.escrivivir.co
SCRIPTORIUM_ADMIN_DOMAIN=admin.scriptorium.escrivivir.co
SCRIPTORIUM_MCP_DOMAIN=mcp.scriptorium.escrivivir.co
SCRIPTORIUM_NPM_DOMAIN=npm.scriptorium.escrivivir.co
SCRIPTORIUM_EXPECTED_VPS_IP=92.243.24.163
CADDY_EMAIL=ops@escrivivir.co
SCRIPTORIUM_TZ=UTC

# Identidad compartida de volúmenes
SCRIPTORIUM_UID=1000
SCRIPTORIUM_GID=1000
SCRIPTORIUM_REMOTE_ROOT=/srv/scriptorium

# Node-RED
NODERED_ADMIN_USER=admin
# Los hashes bcrypt empiezan por `$2...`: en .env real deben ir entre comillas simples.
# Ejemplo: NODERED_ADMIN_PASSWORD_BCRYPT='$2b$10$...'
NODERED_ADMIN_PASSWORD_BCRYPT=CHANGE_ME_BCRYPT
NODERED_VIEWER_USER=viewer
NODERED_VIEWER_PASSWORD_BCRYPT=CHANGE_ME_BCRYPT
NODERED_VIEWER_ENABLED=true
NODERED_CREDENTIAL_SECRET=CHANGE_ME_SECRET
NODERED_PROJECTS_WORKFLOW_MODE=manual
NODERED_LOG_LEVEL=info
NODERED_BASE_IMAGE=nodered/node-red:latest

# MCP DevOps
MCP_DEVOPS_BEARER_TOKEN=CHANGE_ME_TOKEN
MCP_DEVOPS_SCOPES=devops:read,devops:write-definitions,devops:delete-definitions
MCP_DEVOPS_PUBLIC_URL=https://mcp.scriptorium.escrivivir.co/mcp
MCP_DEVOPS_INTERNAL_PORT=3004
MCP_DEVOPS_AUDIT_DIR=/workspace/audit
DEVOPS_ROOM_PLUGIN_ENABLED=false
XPLUS1_PLUGIN_DISABLED=true

# Verdaccio
VERDACCIO_ADMIN_USER=admin
VERDACCIO_ADMIN_PASSWORD=CHANGE_ME_PASSWORD
VERDACCIO_NPM_TOKEN=CHANGE_ME_TOKEN
VERDACCIO_PUBLIC_URL=https://npm.scriptorium.escrivivir.co

# SFTP / SSH helpers operativos (placeholders; no secretos reales)
SCRIPTORIUM_SSH_HOST=scriptorium.escrivivir.co
SCRIPTORIUM_SSH_USER=deploy
SCRIPTORIUM_SSH_PORT=22
SCRIPTORIUM_SSH_KEY_PATH=~/.ssh/id_ed25519
SCRIPTORIUM_SSH_KEY_PASSPHRASE=

# Candados explícitos para operaciones vivas
SCRIPTORIUM_ALLOW_REMOTE_READ=
SCRIPTORIUM_DEPLOY_CONFIRM=

# Nota:
# Copia este archivo a .env y sustituye los placeholders por secretos reales
# solo en el entorno de despliegue, nunca en el repositorio.

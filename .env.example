# Dominios públicos
SCRIPTORIUM_DOMAIN=scriptorium.escrivivir.co
SCRIPTORIUM_ADMIN_DOMAIN=admin.scriptorium.escrivivir.co
SCRIPTORIUM_MCP_DOMAIN=mcp.scriptorium.escrivivir.co
SCRIPTORIUM_NPM_DOMAIN=npm.scriptorium.escrivivir.co
CADDY_EMAIL=ops@escrivivir.co
SCRIPTORIUM_TZ=UTC

# Identidad compartida de volúmenes
SCRIPTORIUM_UID=1000
SCRIPTORIUM_GID=1000

# Node-RED
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASSWORD_BCRYPT=CHANGE_ME_BCRYPT
NODERED_VIEWER_USER=viewer
NODERED_VIEWER_PASSWORD_BCRYPT=CHANGE_ME_BCRYPT

# MCP DevOps
MCP_DEVOPS_BEARER_TOKEN=CHANGE_ME_TOKEN
MCP_DEVOPS_SCOPES=devops:read,devops:write-definitions,devops:delete-definitions

# Verdaccio
VERDACCIO_ADMIN_USER=admin
VERDACCIO_ADMIN_PASSWORD=CHANGE_ME_PASSWORD

# SFTP / helpers operativos
SFTP_HOST=vps.example.com
SFTP_PORT=22
SFTP_USER=scriptorium
SFTP_REMOTE_ROOT=/srv/scriptorium

# Nota:
# Copia este archivo a .env y sustituye los placeholders por secretos reales
# solo en el entorno de despliegue, nunca en el repositorio.
